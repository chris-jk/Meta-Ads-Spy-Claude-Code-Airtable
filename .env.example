# Meta Ad Library access token.
# Get one from https://developers.facebook.com/tools/explorer/ (or any Meta developer app).
# Only needs "public_profile" permission — the Ad Library endpoint is public.
META_ACCESS_TOKEN=

# Meta Marketing API token (System User token from your Business Manager).
# Required scopes: ads_management, ads_read, pages_show_list, pages_read_engagement.
# Only needed if you want to LAUNCH ads (create_campaigns.py), not just scrape them.
# Generate at https://business.facebook.com -> Business Settings -> System Users -> Generate Token.
META_MARKETING_TOKEN=

# Airtable Personal Access Token.
# Create one at https://airtable.com/create/tokens
# Required scopes: data.records:write, schema.bases:read
# Grant access to the base you copied in Step 1.
AIRTABLE_PAT=

# Airtable base ID (the app... string in your base URL).
# Set this so scripts default to it without passing --base-id every time.
AIRTABLE_BASE_ID=
